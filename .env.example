# Copiar a .env y completar. El .env NO se versiona.
AMV_BASE_URL=https://qa.amv.travel
AMV_BO_URL=https://qa.bo.amv.travel
AMV_USER=Pablo@amv.travel
AMV_PASS=
BO_USER=Pablo@amv.travel
BO_PASS=
# Usuario propio del test de markups (agencia 6334, mercado 37).
AMV_MARKUP_USER=autoqa.markups
AMV_MARKUP_PASS=
# Link de autologin de SIX del pasajero AUTO-QA del file 33379 (no vence). Se copia del
# modal SIX del Rooming en el BO. Es una credencial: solo en .env y en los secrets.
AMV_SIX_AUTOLOGIN_URL=
# Clave de la API de MailerLite, para el test de sincronizacion de clientes. Tiene que ser
# la de la MISMA cuenta a la que apunta QA: la fila de Setting
# Advisor.Integration.MailerLite.ApiKey manda por encima del Web.config, y si no coinciden
# el test busca el contacto en una cuenta y el sistema lo crea en otra.
MAILERLITE_API_KEY=

# Movimiento entre sucursales: sucursal destino (BO_USER tiene que tenerla), una caja
# publicada de esa sucursal y su moneda. Si falta alguna, ese test se saltea.
AMV_MOV_SUCURSAL_DESTINO=Colombia
AMV_MOV_CAJA_DESTINO=QA CAJA USD COLOMBIA
AMV_MOV_MONEDA_DESTINO=USD
